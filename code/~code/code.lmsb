CALLSUB100:
    ARRAY COPY VLV_PID_9 VGV_PIDB
    MOVEF_F VLV_UP_9 VLV_UP_4
    MATH NEGATE VLV_UP_4 F.0
    MOVEF_8 F.0 setPowerB
	OUTPUT_POWER 0 2 setPowerB
	OUTPUT_START 0 2
    ADDF VLV_V_PART_4 VLV_W_PART_4 F.2
    MULF F.2 VLV_DT_4 F.1
    DATAF tmpf105
    DATA8 flag105
    DIVF F.1 2000.0 tmpf105
    CP_EQF 0.0 2000.0 flag105
    SELECTF flag105 0.0 tmpf105 F.0

    ADDF VGV_C_POS F.0 VGV_C_POS
    ARRAY COPY VGV_PIDC VLV_PID_IN_9
    OUTPUT_GET_COUNT 0 2 getTachoC
	MOVE32_F getTachoC F.0
    SUBF VGV_C_POS F.0 VLV_ERR_9
    MOVEF_F VLV_TIME_4 VLV_TIME_9
    WRITE32 ENDSUB_M_PID_CALC_5:CALLSUB109 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_M_PID_CALC_5
CALLSUB109:
    ARRAY COPY VLV_PID_9 VGV_PIDC
    MOVEF_F VLV_UP_9 VLV_UP_4
    MOVEF_8 VLV_UP_4 setPowerC
	OUTPUT_POWER 0 4 setPowerC
	OUTPUT_START 0 4
    MOVEF_F VLV_TIME_4 VGV_PREV_MOVE_T
RETSUB_F_MOVE_2:
    SUB8 STACKPOINTER 1 STACKPOINTER
    READ32 RETURNSTACK STACKPOINTER INDEX
    JR_DYNAMIC INDEX
ENDSUB_F_MOVE_2:
SUB_F_ROTIN_1:
    MOVEF_F 0.0 VLV_BET_5
  while111:
  whilebody111:
    CALL ARRAYGET_FLOAT 2.0 VLV_ANG1_1 VGV_COORDS
    MOVEF_F VLV_ANG_5 VLV_ANG2_1
    WRITE32 ENDSUB_F_BETWEEN_3:CALLSUB113 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_BETWEEN_3
CALLSUB113:
    MOVEF_F VLV_THETA_1 VLV_BET_5
    JR_LTEQF VLV_BET_5 0.02 else114_1
    MOVEF_F 0.0 VLV_V_4
    MOVEF_F 1.5 VLV_W_4
    WRITE32 ENDSUB_F_MOVE_2:CALLSUB115 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_MOVE_2
CALLSUB115:
    JR endif114
  else114_1:
    JR_GTEQF VLV_BET_5 -0.02 else114_2
    MOVEF_F 0.0 VLV_V_4
    MOVEF_F -1.5 VLV_W_4
    WRITE32 ENDSUB_F_MOVE_2:CALLSUB116 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_MOVE_2
CALLSUB116:
    JR endif114
  else114_2:
    JR LLL_ENDROT_5
  else114_3:
  endif114:
    DATA32 milliseconds117
	MOVEF_32 2.0 milliseconds117
	DATA32 timer117
	TIMER_WAIT milliseconds117 timer117
	TIMER_READY timer117
    JR whilebody111
  endwhile111:
  LLL_ENDROT_5:
    OUTPUT_POWER 0 6 0
	OUTPUT_STOP 0 6 1
RETSUB_F_ROTIN_1:
    SUB8 STACKPOINTER 1 STACKPOINTER
    READ32 RETURNSTACK STACKPOINTER INDEX
    JR_DYNAMIC INDEX
ENDSUB_F_ROTIN_1:
SUB_F_GOIN_3:
    CALL ARRAYGET_FLOAT 0.0 F.0 VGV_COORDS
    SUBF VLV_X_6 F.0 VLV_DX_2
    CALL ARRAYGET_FLOAT 1.0 F.0 VGV_COORDS
    SUBF VLV_Y_6 F.0 VLV_DY_2
    WRITE32 ENDSUB_F_ATAN2_3:CALLSUB123 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_ATAN2_3
CALLSUB123:
    MOVEF_F VLV_ANG_2 VLV_DIR_6
    STRINGS VALUE_FORMATTED VLV_DIR_6 '%g' 99 S.0
    CALL LCD.TEXT 1.0 10.0 80.0 2.0 S.0
    WRITE32 ENDSUB_F_RESET_0:CALLSUB126 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_RESET_0
CALLSUB126:
    MOVEF_F VLV_DIR_6 VLV_ANG_5
    WRITE32 ENDSUB_F_ROTIN_1:CALLSUB127 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_ROTIN_1
CALLSUB127:
    DATA32 milliseconds128
	MOVEF_32 100.0 milliseconds128
	DATA32 timer128
	TIMER_WAIT milliseconds128 timer128
	TIMER_READY timer128
    CALL ARRAYGET_FLOAT 0.0 F.4 VGV_COORDS
    SUBF VLV_X_6 F.4 F.3
    CALL ARRAYGET_FLOAT 0.0 F.5 VGV_COORDS
    SUBF VLV_X_6 F.5 F.4
    MULF F.3 F.4 F.2
    CALL ARRAYGET_FLOAT 1.0 F.5 VGV_COORDS
    SUBF VLV_Y_6 F.5 F.4
    CALL ARRAYGET_FLOAT 1.0 F.6 VGV_COORDS
    SUBF VLV_Y_6 F.6 F.5
    MULF F.4 F.5 F.3
    ADDF F.2 F.3 F.1
    MATH SQRT F.1 F.0
    MULF F.0 18.5 VLV_LEN_6
    WRITE32 ENDSUB_F_RESET_0:CALLSUB142 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_RESET_0
CALLSUB142:
  while143:
    OUTPUT_GET_COUNT 0 2 getTachoC
	MOVE32_F getTachoC F.0
    JR_GTEQF F.0 VLV_LEN_6 endwhile143
  whilebody143:
    MOVEF_F 15.0 VLV_V_4
    MOVEF_F 0.0 VLV_W_4
    WRITE32 ENDSUB_F_MOVE_2:CALLSUB145 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_MOVE_2
CALLSUB145:
    DATA32 milliseconds146
	MOVEF_32 3.0 milliseconds146
	DATA32 timer146
	TIMER_WAIT milliseconds146 timer146
	TIMER_READY timer146
    OUTPUT_GET_COUNT 0 2 getTachoC
	MOVE32_F getTachoC F.0
    JR_LTF F.0 VLV_LEN_6 whilebody143
  endwhile143:
    OUTPUT_POWER 0 6 0
	OUTPUT_STOP 0 6 1
    WRITE32 ENDSUB_F_RESET_0:CALLSUB149 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_RESET_0
CALLSUB149:
    MOVEF_F VLV_ANG_6 VLV_ANG_5
    WRITE32 ENDSUB_F_ROTIN_1:CALLSUB150 STACKPOINTER RETURNSTACK
    ADD8 STACKPOINTER 1 STACKPOINTER
    JR SUB_F_ROTIN_1
CALLSUB150:
RETSUB_F_GOIN_3:
    SUB8 STACKPOINTER 1 STACKPOINTER
    READ32 RETURNSTACK STACKPOINTER INDEX
    JR_DYNAMIC INDEX
ENDSUB_F_GOIN_3:
SUB_M_PID_INIT_5:
    CALL VECTOR.INIT 7.0 0.0 VLV_PID_7
    CALL ARRAYSTORE_FLOAT 1.0 VLV_KP_7 VLV_PID_7
    CALL ARRAYSTORE_FLOAT 2.0 VLV_KD_7 VLV_PID_7
    CALL ARRAYSTORE_FLOAT 3.0 VLV_KI_7 VLV_PID_7
    CALL ARRAYSTORE_FLOAT 4.0 VLV_I_OVER_7 VLV_PID_7
RETSUB_M_PID_INIT_5:
    SUB8 STACKPOINTER 1 STACKPOINTER
    READ32 RETURNSTACK STACKPOINTER INDEX
    JR_DYNAMIC INDEX
ENDSUB_M_PID_INIT_5:
SUB_M_PID_RESET_2:
    ARRAY COPY VLV_PID_IN_8 VLV_PID_8
    CALL ARRAYSTORE_FLOAT 5.0 0.0 VLV_PID_8
    CALL ARRAYSTORE_FLOAT 6.0 0.0 VLV_PID_8
RETSUB_M_PID_RESET_2:
    SUB8 STACKPOINTER 1 STACKPOINTER
    READ32 RETURNSTACK STACKPOINTER INDEX
    JR_DYNAMIC INDEX
ENDSUB_M_PID_RESET_2:
SUB_M_PID_CALC_5:
    ARRAY COPY VLV_PID_IN_9 VLV_PID_9
    CALL ARRAYGET_FLOAT 7.0 F.0 VLV_PID_9
    SUBF VLV_TIME_9 F.0 VLV_DT_9
    CALL ARRAYSTORE_FLOAT 7.0 VLV_TIME_9 VLV_PID_9
    CALL ARRAYGET_FLOAT 6.0 F.1 VLV_PID_9
    CALL ARRAYGET_FLOAT 3.0 F.4 VLV_PID_9
    MULF VLV_ERR_9 F.4 F.3
    MULF F.3 VLV_DT_9 F.2
    ADDF F.1 F.2 F.0
    CALL ARRAYSTORE_FLOAT 6.0 F.0 VLV_PID_9
    CALL ARRAYGET_FLOAT 6.0 F.0 VLV_PID_9
    CALL ARRAYGET_FLOAT 4.0 F.1 VLV_PID_9
    JR_LTEQF F.0 F.1 else167_1
    CALL ARRAYGET_FLOAT 4.0 F.0 VLV_PID_9
    CALL ARRAYSTORE_FLOAT 6.0 F.0 VLV_PID_9
    JR endif167
  else167_1:
    CALL ARRAYGET_FLOAT 6.0 F.0 VLV_PID_9
    CALL ARRAYGET_FLOAT 4.0 F.2 VLV_PID_9
    MATH NEGATE F.2 F.1
    JR_GTEQF F.0 F.1 else167_2
    CALL ARRAYGET_FLOAT 4.0 F.1 VLV_PID_9
    MATH NEGATE F.1 F.0
    CALL ARRAYSTORE_FLOAT 6.0 F.0 VLV_PID_9
  else167_2:
  endif167:
    CALL ARRAYGET_FLOAT 1.0 F.3 VLV_PID_9
    MULF VLV_ERR_9 F.3 F.2
    CALL ARRAYGET_FLOAT 5.0 F.6 VLV_PID_9
    SUBF VLV_ERR_9 F.6 F.5
    CALL ARRAYGET_FLOAT 2.0 F.6 VLV_PID_9
    MULF F.5 F.6 F.4
    MULF F.4 VLV_DT_9 F.3
    ADDF F.2 F.3 F.1
    CALL ARRAYGET_FLOAT 6.0 F.2 VLV_PID_9
    ADDF F.1 F.2 F.0
    CALL ARRAYSTORE_FLOAT 0.0 F.0 VLV_PID_9
    CALL ARRAYGET_FLOAT 0.0 VLV_UP_9 VLV_PID_9
    CALL ARRAYSTORE_FLOAT 5.0 VLV_ERR_9 VLV_PID_9
RETSUB_M_PID_CALC_5:
    SUB8 STACKPOINTER 1 STACKPOINTER
    READ32 RETURNSTACK STACKPOINTER INDEX
    JR_DYNAMIC INDEX
ENDSUB_M_PID_CALC_5:
}
subcall ARRAYSTORE_FLOAT   // FFFV
{
	IN_F index
	IN_F value	
	IN_16 handle
	
	DATA32 index32
	DATA32 len	
	MOVEF_32 index index32

	ARRAY SIZE handle len
	JR_LT32 index32 0 negativeindex
	JR_LT32 index32 len arraybigenough

increasesize:	
	DATA32 doublelen
	ADD32 len len doublelen
	ARRAY RESIZE handle doublelen
writeloop:	
	ARRAY_WRITE handle len 0.0
	ADD32 len 1 len
	JR_LT32 len doublelen writeloop
	JR_GTEQ32 index32 len increasesize
	
arraybigenough:
	ARRAY_WRITE handle index32 value
negativeindex:
}
subcall EV3FILE.OPENREAD       // SF
{
	IN_S filename 252
	OUT_F handle

	DATAS fullname 300
	DATA16 handle16
	DATA32 dummylength

	STRINGS DUPLICATE filename fullname
	JR_EQ8 filename 47 absolutepath               // filename begins with a '/'
	STRINGS ADD '/home/root/lms2012/prjs/' filename fullname
absolutepath:
	FILE OPEN_READ fullname handle16 dummylength

	MOVE16_F handle16 handle
}
subcall EV3FILE.READNUMBERARRAY    // FFA
{
	IN_F handle
	IN_F size
	IN_16 a

	JR_LTF handle 1.0 invalidhandle
	JR_GTF handle 32767.0 invalidhandle
	DATA16 handle16
	DATA8 byte8
	MOVEF_16 handle handle16

	DATA32 size32
	MOVEF_32 size size32
	JR_LTEQ32 size32 0 empty

	ARRAY RESIZE a size32
	ARRAY FILL a 0.0

	MUL32 size32 4 size32  // from here calculate all in bytes
	DATA32 offset          // position where to put data
	ARRAY8 buffer 4000     // buffer is big enough to hold 1000 float values at once
	MOVE32_32 0 offset     // byte offset into array
copyloop:
	JR_LTEQ32 size32 4000 lastchunk
    FILE READ_BYTES handle16 4000 buffer 
    ARRAY WRITE_CONTENT 1 a offset 4000 buffer
	ADD32 offset 4000 offset
	SUB32 size32 4000 size32
	JR copyloop

lastchunk:
	DATA16 size16
	MOVE32_16 size32 size16
	FILE READ_BYTES handle16 size16 buffer 
  	ARRAY WRITE_CONTENT 1 a offset size32 buffer

	RETURN

invalidhandle:
empty:
    ARRAY RESIZE a 0
}
subcall LCD.CLEAR   // V
{
	UI_DRAW(TOPLINE,0)
	UI_DRAW(CLEAN)
	
	JR_NEQ32 0 STOPLCDUPDATE skipupdate
	UI_DRAW UPDATE
skipupdate:
}
subcall VECTOR.INIT       // FFA
{
	IN_F size
	IN_F value
	IN_16 a

	DATA32 size32
	MOVEF_32 size size32
	JR_LTEQ32 size32 0 empty

	ARRAY RESIZE a size32
	ARRAY FILL a value
	RETURN

empty:
    ARRAY RESIZE a 0
}
subcall EV3FILE.OPENWRITE       // SF
{
	IN_S filename 252
	OUT_F handle

	DATAS fullname 300
	DATA16 handle16

	STRINGS DUPLICATE filename fullname
	JR_EQ8 filename 47 absolutepath               // filename begins with a '/'
	STRINGS ADD '/home/root/lms2012/prjs/' filename fullname
absolutepath:
	FILE OPEN_WRITE fullname handle16

	MOVE16_F handle16 handle
}
subcall EV3FILE.WRITENUMBERARRAY    // FFAV
{
	IN_F handle
	IN_F size
	IN_16 a

	JR_LTF handle 1.0 invalidhandle
	JR_GTF handle 32767.0 invalidhandle
	DATA16 handle16
	DATA8 byte8
	MOVEF_16 handle handle16

	DATA32 size32
	MOVEF_32 size size32
	JR_LTEQ32 size32 0 empty

	DATA32 len          // real size of array
	ARRAY SIZE a len

	ARRAY8 buffer 4     // buffer for a single float

	DATA32 i            // loop counter
	MOVE32_32 0 i
copyloop:
	JR_GTEQ32 i size32 over
	JR_GTEQ32 i len outofbounds
	ARRAY_READ a i buffer
outofbounds:
	FILE WRITE_BYTES handle16 4 buffer

	ADD32 i 1 i
	JR copyloop

over:
invalidhandle:
empty:
	RETURN
}
subcall ARRAYGET_FLOAT     // FFF
{
	IN_F index
	OUT_F value
	IN_16 handle
	
	DATA32 index32
	DATA32 len
	MOVEF_32 index index32
	
	ARRAY SIZE handle len
	JR_LT32 index32 0 outofbounds
	JR_GTEQ32 index32 len outofbounds
	
	ARRAY_READ handle index32 value
	RETURN
outofbounds:
	MOVE8_F 0 value	
}
subcall LCD.TEXT     // FFFFSV
{
	IN_F col
	IN_F x
	IN_F y
	IN_F font
	IN_S text 252
	
	DATA8 col_8
	DATA16 x_16
	DATA16 y_16
	DATA8 font_8	
	MOVEF_8 col col_8
	MOVEF_16 x x_16
	MOVEF_16 y y_16
	MOVEF_8 font font_8
	
	UI_DRAW SELECT_FONT font_8
	UI_DRAW TEXT col_8 x_16 y_16 text

	JR_NEQ32 0 STOPLCDUPDATE skipupdate
	UI_DRAW UPDATE
skipupdate:
}
subcall ARRAYCREATE_FLOAT   // F
{
	OUT_16 handle
	
	ARRAY CREATEF 8 handle			// create with 8 elements
	ARRAY FILL handle 0.0
}
subcall GETANDINC32     // V
{
	IN_32 counterin
	IN_32 inc
	OUT_32 counterout
	OUT_32 prev

	MOVE32_32 counterin prev
	ADD32 counterin inc counterout
}
