lv_pid_8 [ 0 ] = 0
lv_pid_in_9 [ 0 ] = 0
lv_err_9 = 0
lv_time_9 = 0
lv_pid_9 [ 0 ] = 0
lv_up_9 = 0
lv_v_4 = 0
lv_w_4 = 0
lv_dx_2 = 0
lv_dy_2 = 0
lv_ang_2 = 0
lv_ang_5 = 0
gv_pidb [ 0 ] = 0
gv_pidc [ 0 ] = 0
gv_v = 0
gv_w = 0
lv_up_4 = 0
lv_bet_5 = 0
lv_dir_6 = 0
gv_encb_last = 0
gv_encc_last = 0
gv_threads_flag = 0
gv_coords_save = 0
gv_coords [ 0 ] = 0
gv_prev_move_t = 0
gv_b_pos = 0
gv_c_pos = 0
gv_encb_last = 0
gv_encc_last = 0
gv_threads_flag = 1
gv_threads_flag = 1
lv_kp_7 = 3.2
lv_kd_7 = 0.2
lv_ki_7 = 0.003
lv_i_over_7 = 15
m_pid_init_5 ()
gv_pidb = lv_pid_7
lv_kp_7 = 3.2
lv_kd_7 = 0.2
lv_ki_7 = 0.003
lv_i_over_7 = 15
m_pid_init_5 ()
gv_pidc = lv_pid_7
GV_COORDS_SAVE = EV3File.OpenRead ( "China/Files/Coords" )
gv_coords = EV3File.ReadNumberArray ( gv_coords_save , 3 )
gv_prev_move_t = 0
gv_b_pos = 0
gv_c_pos = 0
LCD.Clear ()
Thread.Run = f_lcdcoords_0
Thread.Run = f_calccoords_0
gv_coords = Vector.Init ( 3 , 0 )
lv_x_6 = 10
lv_y_6 = 40
lv_ang_6 = 1.3
f_goin_3 ()
f_shoot_0 ()
lv_x_6 = 0
lv_y_6 = 0
lv_ang_6 = 0
f_goin_3 ()
GV_COORDS_SAVE = EV3File.OpenWrite ( "China/Files/Coords" )
EV3File.WriteNumberArray ( gv_coords_save , 3 , gv_coords )
Sub f_calccoords_0
While gv_threads_flag = 1
gv_v = 0
gv_w = 0
f_dirvelocity_2 ()
gv_v = lv_v_3
gv_w = lv_w_3
gv_coords [ 2 ] = gv_coords [ 2 ] + gv_w / 2
gv_coords [ 0 ] = gv_coords [ 0 ] + gv_v * Math.Cos ( gv_coords [ 2 ] )
gv_coords [ 1 ] = gv_coords [ 1 ] + gv_v * Math.Sin ( gv_coords [ 2 ] )
gv_coords [ 2 ] = gv_coords [ 2 ] + gv_w / 2
lv_ang1_1 = 0
lv_ang2_1 = gv_coords [ 2 ]
f_between_3 ()
gv_coords [ 2 ] = lv_theta_1
Program.Delay ( 11 )
EndWhile
EndSub
Sub f_lcdcoords_0
While gv_threads_flag = 1
LCD.Text ( 1 , 10 , 20 , 2 , gv_coords [ 0 ] )
LCD.Text ( 1 , 10 , 40 , 2 , gv_coords [ 1 ] )
LCD.Text ( 1 , 10 , 60 , 2 , gv_coords [ 2 ] )
Program.Delay ( 100 )
EndWhile
EndSub
Sub f_reset_0
MotorB.ResetCount ()
MotorC.ResetCount ()
gv_encb_last = 0
gv_encc_last = 0
gv_b_pos = 0
gv_c_pos = 0
lv_pid_in_8 = gv_pidb
m_pid_reset_2 ()
gv_pidb = lv_pid_8
lv_pid_in_8 = gv_pidc
m_pid_reset_2 ()
gv_pidc = lv_pid_8
Time.Reset1 ()
gv_prev_move_t = Time.Get1 ()
EndSub
Sub f_shoot_0
MotorAD.StartPower ( - 90 )
Program.Delay ( 5000 )
MotorAD.OffAndBrake ()
EndSub
Sub f_between_3
lv_theta_1 = lv_ang2_1 - lv_ang1_1
If lv_theta_1 > 3.1415 Then
lv_theta_1 = lv_theta_1 - 6.283
ElseIf lv_theta_1 < - 3.1415 Then
lv_theta_1 = lv_theta_1 + 6.283
EndIf
EndSub
Sub f_atan2_3
If lv_dx_2 <> 0 Then
lv_ang_2 = Math.ArcTan ( lv_dy_2 / lv_dx_2 )
If lv_dy_2 = 0 Then
If lv_dx_2 >= 0 Then
lv_ang_2 = 0
Else
lv_ang_2 = 3.1415
EndIf
ElseIf lv_dx_2 < 0 Then
lv_ang_2 = 3.1415 + lv_ang_2
EndIf
Else
If lv_dy_2 >= 0 Then
lv_ang_2 = 1.57
Else
lv_ang_2 = - 1.57
EndIf
EndIf
EndSub
Sub f_dirvelocity_2
lv_db_3 = 0 - MotorB.GetTacho () - gv_encb_last
lv_dc_3 = MotorC.GetTacho () - gv_encc_last
lv_v_3 = ( lv_db_3 + lv_dc_3 ) / 37
lv_w_3 = ( lv_dc_3 - lv_db_3 ) / 289.5
gv_encb_last = 0 - MotorB.GetTacho ()
gv_encc_last = MotorC.GetTacho ()
EndSub
Sub f_move_2
lv_time_4 = Time.Get1 ()
lv_dt_4 = lv_time_4 - gv_prev_move_t
lv_v_part_4 = lv_v_4 * 37
lv_w_part_4 = lv_w_4 * 289.5
gv_b_pos = gv_b_pos + ( lv_v_part_4 - lv_w_part_4 ) * lv_dt_4 / 2000
lv_pid_in_9 = gv_pidb
lv_err_9 = gv_b_pos + MotorB.GetTacho ()
lv_time_9 = lv_time_4
m_pid_calc_5 ()
gv_pidb = lv_pid_9
lv_up_4 = lv_up_9
MotorB.StartPower ( - lv_up_4 )
gv_c_pos = gv_c_pos + ( lv_v_part_4 + lv_w_part_4 ) * lv_dt_4 / 2000
lv_pid_in_9 = gv_pidc
lv_err_9 = gv_c_pos - MotorC.GetTacho ()
lv_time_9 = lv_time_4
m_pid_calc_5 ()
gv_pidc = lv_pid_9
lv_up_4 = lv_up_9
MotorC.StartPower ( lv_up_4 )
gv_prev_move_t = lv_time_4
EndSub
Sub f_rotin_1
lv_bet_5 = 0
While "True"
lv_ang1_1 = gv_coords [ 2 ]
lv_ang2_1 = lv_ang_5
f_between_3 ()
lv_bet_5 = lv_theta_1
If lv_bet_5 > 0.02 Then
lv_v_4 = 0
lv_w_4 = 1.5
f_move_2 ()
ElseIf lv_bet_5 < - 0.02 Then
lv_v_4 = 0
lv_w_4 = - 1.5
f_move_2 ()
Else
Goto ll_endrot_5
EndIf
Program.Delay ( 2 )
EndWhile
ll_endrot_5:
MotorBC.OffAndBrake ()
EndSub
Sub f_goin_3
lv_dx_2 = ( lv_x_6 - gv_coords [ 0 ] )
lv_dy_2 = ( lv_y_6 - gv_coords [ 1 ] )
f_atan2_3 ()
lv_dir_6 = lv_ang_2
LCD.Text ( 1 , 10 , 80 , 2 , lv_dir_6 )
f_reset_0 ()
lv_ang_5 = lv_dir_6
f_rotin_1 ()
Program.Delay ( 100 )
lv_len_6 = Math.SquareRoot ( ( lv_x_6 - gv_coords [ 0 ] ) * ( lv_x_6 - gv_coords [ 0 ] ) + ( lv_y_6 - gv_coords [ 1 ] ) * ( lv_y_6 - gv_coords [ 1 ] ) ) * 18.5
f_reset_0 ()
While MotorC.GetTacho () < lv_len_6
lv_v_4 = 15
lv_w_4 = 0
f_move_2 ()
Program.Delay ( 3 )
EndWhile
MotorBC.OffAndBrake ()
f_reset_0 ()
lv_ang_5 = lv_ang_6
f_rotin_1 ()
EndSub
Sub m_pid_init_5
lv_pid_7 = Vector.Init ( 7 , 0 )
lv_pid_7 [ 1 ] = lv_kp_7
lv_pid_7 [ 2 ] = lv_kd_7
lv_pid_7 [ 3 ] = lv_ki_7
lv_pid_7 [ 4 ] = lv_i_over_7
EndSub
Sub m_pid_reset_2
lv_pid_8 = lv_pid_in_8
lv_pid_8 [ 5 ] = 0
lv_pid_8 [ 6 ] = 0
EndSub
Sub m_pid_calc_5
lv_pid_9 = lv_pid_in_9
lv_dt_9 = lv_time_9 - lv_pid_9 [ 7 ]
lv_pid_9 [ 7 ] = lv_time_9
lv_pid_9 [ 6 ] = lv_pid_9 [ 6 ] + lv_err_9 * lv_pid_9 [ 3 ] * lv_dt_9
If lv_pid_9 [ 6 ] > lv_pid_9 [ 4 ] Then
lv_pid_9 [ 6 ] = lv_pid_9 [ 4 ]
ElseIf lv_pid_9 [ 6 ] < - lv_pid_9 [ 4 ] Then
lv_pid_9 [ 6 ] = - lv_pid_9 [ 4 ]
EndIf
lv_pid_9 [ 0 ] = lv_err_9 * lv_pid_9 [ 1 ] + ( lv_err_9 - lv_pid_9 [ 5 ] ) * lv_pid_9 [ 2 ] * lv_dt_9 + lv_pid_9 [ 6 ]
lv_up_9 = lv_pid_9 [ 0 ]
lv_pid_9 [ 5 ] = lv_err_9
EndSub
