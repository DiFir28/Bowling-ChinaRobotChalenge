Sub f_calccoords_0
While gv_threads_flag = 1
gv_v = 0
gv_w = 0
f_dirvelocity_2 ()
gv_v = lv_v_5
gv_w = lv_w_5
gv_coords [ 2 ] = gv_coords [ 2 ] + gv_w / 2
gv_coords [ 0 ] = gv_coords [ 0 ] + gv_v * Math.Cos ( gv_coords [ 2 ] )
gv_coords [ 1 ] = gv_coords [ 1 ] + gv_v * Math.Sin ( gv_coords [ 2 ] )
gv_coords [ 2 ] = gv_coords [ 2 ] + gv_w / 2
lv_ang1_1 = 0
lv_ang2_1 = gv_coords [ 2 ]
f_between_3 ()
gv_coords [ 2 ] = lv_theta_1
Program.Delay ( 11 )
EndWhile
EndSub
Sub f_lcdcoords_0
While gv_threads_flag = 1
LCD.Text ( 1 , 10 , 20 , 2 , gv_coords [ 0 ] )
LCD.Text ( 1 , 10 , 40 , 2 , gv_coords [ 1 ] )
LCD.Text ( 1 , 10 , 60 , 2 , gv_coords [ 2 ] )
LCD.Text ( 1 , 10 , 80 , 2 , gv_lcdbuf [ 0 ] )
LCD.Text ( 1 , 10 , 100 , 2 , gv_lcdbuf [ 1 ] )
Program.Delay ( 81 )
EndWhile
EndSub
Sub f_reset_0
MotorB.ResetCount ()
MotorC.ResetCount ()
gv_encb_last = 0
gv_encc_last = 0
gv_b_pos = 0
gv_c_pos = 0
lv_pid_in_11 = gv_pidb
m_pid_reset_2 ()
gv_pidb = lv_pid_11
lv_pid_in_11 = gv_pidc
m_pid_reset_2 ()
gv_pidc = lv_pid_11
lv_pid_in_11 = gv_pointfollowing
m_pid_reset_2 ()
gv_pointfollowing = lv_pid_11
Time.Reset1 ()
gv_prev_move_t = Time.Get1 ()
EndSub
Sub f_shoot_0
MotorAD.StartPower ( - 90 )
Program.Delay ( 300 )
MotorAD.StartPower ( - 100 )
Program.Delay ( 5200 )
MotorAD.StartPower ( - 80 )
Program.Delay ( 500 )
MotorAD.StartPower ( - 60 )
Program.Delay ( 300 )
MotorAD.OffAndBrake ()
EndSub
Sub f_between_3
lv_theta_1 = lv_ang2_1 - lv_ang1_1
If lv_theta_1 > 3.1415 Then
lv_theta_1 = lv_theta_1 - 6.283
ElseIf lv_theta_1 < - 3.1415 Then
lv_theta_1 = lv_theta_1 + 6.283
EndIf
EndSub
Sub f_atan2_3
If lv_dx_2 <> 0 Then
lv_ang_2 = Math.ArcTan ( lv_dy_2 / lv_dx_2 )
If lv_dy_2 = 0 Then
If lv_dx_2 >= 0 Then
lv_ang_2 = 0
Else
lv_ang_2 = 3.1415
EndIf
ElseIf lv_dx_2 < 0 Then
lv_ang_2 = 3.1415 + lv_ang_2
EndIf
Else
If lv_dy_2 >= 0 Then
lv_ang_2 = 1.57
Else
lv_ang_2 = - 1.57
EndIf
EndIf
EndSub
Sub f_ro_3
lv_ro_3 = ( lv_a_3 [ 0 ] - lv_b_3 [ 0 ] ) * ( lv_a_3 [ 0 ] - lv_b_3 [ 0 ] ) + ( lv_a_3 [ 1 ] - lv_b_3 [ 1 ] ) * ( lv_a_3 [ 1 ] - lv_b_3 [ 1 ] )
lv_ro_3 = Math.SquareRoot ( lv_ro_3 )
EndSub
Sub f_rotation_3
lv_ra_4 = lv_a_4
lv_cos_4 = Math.Cos ( lv_theta_4 )
lv_sin_4 = Math.Sin ( lv_theta_4 )
lv_ra_4 [ 0 ] = lv_cos_4 * lv_a_4 [ 0 ] - lv_sin_4 * lv_a_4 [ 1 ]
lv_ra_4 [ 1 ] = lv_sin_4 * lv_a_4 [ 0 ] + lv_cos_4 * lv_a_4 [ 1 ]
EndSub
Sub f_dirvelocity_2
lv_db_5 = 0 - MotorB.GetTacho () - gv_encb_last
lv_dc_5 = MotorC.GetTacho () - gv_encc_last
lv_v_5 = ( lv_db_5 + lv_dc_5 ) / 37
lv_w_5 = ( lv_dc_5 - lv_db_5 ) / 289.5
gv_encb_last = 0 - MotorB.GetTacho ()
gv_encc_last = MotorC.GetTacho ()
EndSub
Sub f_move_2
lv_time_6 = Time.Get1 ()
lv_dt_6 = lv_time_6 - gv_prev_move_t
lv_v_part_6 = lv_v_6 * 37
lv_w_part_6 = lv_w_6 * 289.5
gv_b_pos = gv_b_pos + ( lv_v_part_6 - lv_w_part_6 ) * lv_dt_6 / 2000
lv_pid_in_12 = gv_pidb
lv_err_12 = gv_b_pos + MotorB.GetTacho ()
lv_time_12 = lv_time_6
m_pid_calc_5 ()
gv_pidb = lv_pid_12
lv_up_6 = lv_up_12
MotorB.StartPower ( - lv_up_6 )
gv_c_pos = gv_c_pos + ( lv_v_part_6 + lv_w_part_6 ) * lv_dt_6 / 2000
lv_pid_in_12 = gv_pidc
lv_err_12 = gv_c_pos - MotorC.GetTacho ()
lv_time_12 = lv_time_6
m_pid_calc_5 ()
gv_pidc = lv_pid_12
lv_up_6 = lv_up_12
MotorC.StartPower ( lv_up_6 )
gv_prev_move_t = lv_time_6
EndSub
Sub f_rotin_1
lv_bet_7 = 0
While "True"
lv_ang1_1 = gv_coords [ 2 ]
lv_ang2_1 = lv_ang_7
f_between_3 ()
lv_bet_7 = lv_theta_1
If lv_bet_7 > 0.01 Then
lv_v_6 = 0
lv_w_6 = 1.2
f_move_2 ()
ElseIf lv_bet_7 < - 0.01 Then
lv_v_6 = 0
lv_w_6 = - 1.2
f_move_2 ()
Else
Goto ll_endrot_7
EndIf
Program.Delay ( 2 )
EndWhile
ll_endrot_7:
MotorBC.OffAndBrake ()
EndSub
Sub f_goin_3
lv_dx_2 = ( lv_x_9 - gv_coords [ 0 ] )
lv_dy_2 = ( lv_y_9 - gv_coords [ 1 ] )
f_atan2_3 ()
lv_dir_9 = lv_ang_2
f_reset_0 ()
lv_ang_7 = lv_dir_9
f_rotin_1 ()
Program.Delay ( 50 )
lv_trg_9 = Vector.Init ( 3 , 0 )
lv_trg_9 [ 0 ] = lv_x_9 - gv_coords [ 0 ]
lv_trg_9 [ 1 ] = lv_y_9 - gv_coords [ 1 ]
lv_ro_9 = 0
lv_w_9 = 0
lv_zeros_9 = Vector.Init ( 3 , 0 )
lv_a_3 = lv_zeros_9
lv_b_3 = lv_trg_9
f_ro_3 ()
lv_r_9 = lv_ro_3
f_reset_0 ()
While lv_r_9 > 0.25
lv_trg_9 [ 0 ] = lv_x_9 - gv_coords [ 0 ]
lv_trg_9 [ 1 ] = lv_y_9 - gv_coords [ 1 ]
lv_a_4 = lv_trg_9
lv_theta_4 = 0 - gv_coords [ 2 ]
f_rotation_3 ()
lv_rottrg_9 = lv_ra_4
lv_pid_in_12 = gv_pointfollowing
lv_err_12 = lv_rottrg_9 [ 1 ]
lv_time_12 = Time.Get1 ()
m_pid_calc_5 ()
gv_pointfollowing = lv_pid_12
lv_w_9 = lv_up_12
gv_lcdbuf [ 0 ] = lv_w_9
gv_lcdbuf [ 1 ] = lv_r_9
lv_v_6 = 13
lv_w_6 = lv_w_9
f_move_2 ()
Program.Delay ( 3 )
lv_a_3 = lv_zeros_9
lv_b_3 = lv_trg_9
f_ro_3 ()
lv_r_9 = lv_ro_3
EndWhile
MotorBC.OffAndBrake ()
f_reset_0 ()
lv_ang_7 = lv_ang_9
f_rotin_1 ()
EndSub
Sub m_pid_init_5
lv_pid_10 = Vector.Init ( 7 , 0 )
lv_pid_10 [ 1 ] = lv_kp_10
lv_pid_10 [ 2 ] = lv_kd_10
lv_pid_10 [ 3 ] = lv_ki_10
lv_pid_10 [ 4 ] = lv_i_over_10
EndSub
Sub m_pid_reset_2
lv_pid_11 = lv_pid_in_11
lv_pid_11 [ 5 ] = 0
lv_pid_11 [ 6 ] = 0
lv_pid_11 [ 7 ] = 0
EndSub
Sub m_pid_calc_5
lv_pid_12 = lv_pid_in_12
lv_dt_12 = lv_time_12 - lv_pid_12 [ 7 ]
lv_pid_12 [ 7 ] = lv_time_12
lv_pid_12 [ 6 ] = lv_pid_12 [ 6 ] + lv_err_12 * lv_pid_12 [ 3 ] * lv_dt_12
If lv_pid_12 [ 6 ] > lv_pid_12 [ 4 ] Then
lv_pid_12 [ 6 ] = lv_pid_12 [ 4 ]
ElseIf lv_pid_12 [ 6 ] < - lv_pid_12 [ 4 ] Then
lv_pid_12 [ 6 ] = - lv_pid_12 [ 4 ]
EndIf
lv_pid_12 [ 0 ] = lv_err_12 * lv_pid_12 [ 1 ] + ( lv_err_12 - lv_pid_12 [ 5 ] ) * lv_pid_12 [ 2 ] * lv_dt_12 + lv_pid_12 [ 6 ]
lv_up_12 = lv_pid_12 [ 0 ]
lv_pid_12 [ 5 ] = lv_err_12
EndSub
