folder "prjs""China"

include "ImpMath"
include "Odometry"
import "PID"

threads_flag=1

PID.Init(3.1,0.1,0.001,15,pidB)
PID.Init(2.5,0.05,0.0005,15,pidC)

PID.Init(0.1,0.0,0.0,2,pointfollowing)

coords_save=EV3File.OpenRead("Coords")
coords=EV3File.ReadNumberArray(coords_save,3)
prev_move_t=0
B_pos=0
C_pos=0

Sub reset
  MotorB.ResetCount()
  MotorC.ResetCount()
  encB_last=0
  encC_last=0
  B_pos=0
  C_pos=0
  PID.Reset(pidB,pidB)
  PID.Reset(pidC,pidC)
  PID.Reset(pointfollowing,pointfollowing)
  Time.Reset1()
  prev_move_t=Time.Get1()
EndSub

Function move(in number V, in number w) '[V]-cm/s [w]-rad/s
  time=Time.Get1()
  dt=time-@prev_move_t
  V_part=V*37
  w_part=w*289.5
  @B_pos=@B_pos+(V_part-w_part)*dt/2000
  PID.Calc(@pidB,@B_pos+MotorB.GetTacho(),time,@pidB, up)
  MotorB.StartPower(-up)
  @C_pos=@C_pos+(V_part+w_part)*dt/2000
  PID.Calc(@pidC,@C_pos-MotorC.GetTacho(),time,@pidC, up)
  MotorC.StartPower(up)
  @prev_move_t=time
EndFunction

Function RotIn(in number ang)
  bet=0
  While "True"
    between(@coords[2], ang,bet)
    'move(0,bet*2)
    If bet>0.01 Then
      move(0,1.2)
    ElseIf bet<-0.01 Then
      move(0,-1.2)
    Else
      Goto endROT
    EndIf
    Program.Delay(2)
  EndWhile
  endROT:
  MotorBC.OffAndBrake()
EndFunction

Function GoInStrait(in number x, in number y, in number ang)
  atan2((x-@coords[0]), (y-@coords[1]),dir)
  reset()
  RotIn(dir)
  Program.Delay(50)
  len=Math.SquareRoot((x-@coords[0])*(x-@coords[0])+(y-@coords[1])*(y-@coords[1]))*18.5
  reset()
  While MotorC.GetTacho()<len
    move(15,0)
    Program.Delay(3)
  EndWhile
  MotorBC.OffAndBrake()
  reset()
  RotIn(ang)
EndFunction

Function GoIn(in number x, in number y, in number ang)
  atan2((x-@coords[0]), (y-@coords[1]),dir)
  
  reset()
  RotIn(dir)
  Program.Delay(50)
  
  trg=Vector.Init(3,0)
  trg[0]=x-@coords[0]
  trg[1]=y-@coords[1]
  ro=0
  w=0
  zeros=Vector.Init(3,0)
  ro(zeros,trg,R)
  reset()
  'MotorBC.StartPower(0)
  While R>0.25
    trg[0]=x-@coords[0]
    trg[1]=y-@coords[1]
    Rotation(trg,0-@coords[2],rottrg)
    PID.Calc(@pointfollowing,rottrg[1],Time.Get1(),@pointfollowing, w)
    @LCDbuf[0]=w
    @LCDbuf[1]=R
    move(13,w)
    Program.Delay(3)
    ro(zeros,trg,R)
  EndWhile
  MotorBC.OffAndBrake()
  
  reset()
  RotIn(ang)
EndFunction

Sub Shoot
  MotorAD.StartPower(-90)
  Program.Delay(300)
  MotorAD.StartPower(-100)
  Program.Delay(5200)
  MotorAD.StartPower(-80)
  Program.Delay(500)
  MotorAD.StartPower(-60)
  Program.Delay(300)
  MotorAD.OffAndBrake()
EndSub

LCD.Clear()
Thread.Run=LCDcoords
Thread.Run=CALCcoords

coords=Vector.Init(3,0)

'GoIn(100,0,0)
''RotOn(1.3)
GoIn(17,30,1.57)
