Function between(in number ang1, in number ang2,out number theta)
  theta = ang2-ang1
  If theta > 3.1415 Then
    theta-=6.283
  ElseIf theta < -3.1415 Then
    theta+=6.283
  EndIf
EndFunction

Function atan2(in number dx, in number dy, out number ang)
  If dx <>0 Then
    ang = Math.ArcTan(dy/dx)
    If dy=0 Then
      If dx>=0 Then
        ang = 0
      Else
        ang = 3.1415
      EndIf
    ElseIf dx<0 Then
      ang=3.1415+ang
    EndIf
  Else
    If dy>=0 Then
      ang = 1.57
    Else
      ang = -1.57
    EndIf
  EndIf
EndFunction

Function Ro(in number[] A, in number[] B, out number ro)
  ro=(A[0]-B[0])*(A[0]-B[0])+(A[1]-B[1])*(A[1]-B[1])
  ro=Math.SquareRoot(ro)
EndFunction

Function Rotation(in number[] A,in number theta, out number[] rA)
  rA=A
  cos=Math.Cos(theta)
  sin=Math.Sin(theta)
  rA[0]=cos*A[0]-sin*A[1]
  rA[1]=sin*A[0]+cos*A[1]
EndFunction
